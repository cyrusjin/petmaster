/**
 * HP Boxing Gym 风格设计令牌
 * 深海蓝 + 浅灰背景 + 白卡片 + 柔和阴影
 */
page {
  --color-primary: #1D3D7A;
  --color-primary-dark: #1A3B70;
  --color-primary-light: #2B5AA0;
  --color-accent-bg: #F2F4FF;
  --color-bg-page: #F7F8FA;
  --color-bg-card: #FFFFFF;
  --color-bg-subtle: #F7F8FA;
  --color-bg-input: #F7F8FA;
  --color-text-primary: #333333;
  --color-text-heading: #000000;
  --color-text-secondary: #666666;
  --color-text-tertiary: #999999;
  --color-text-muted: #CCCCCC;
  --color-border: #E8ECF0;
  --color-border-light: #F0F2F5;
  --color-danger: #E53935;
  --color-success: #2E7D32;
  --color-warning-bg: #F2F4FF;
  --color-warning-border: #C5CEE0;
  --shadow-card: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  --shadow-btn: 0 6rpx 20rpx rgba(29, 61, 122, 0.22);
  --shadow-stat: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
  --radius-card: 24rpx;
  --radius-md: 16rpx;
  --radius-sm: 12rpx;
  --radius-pill: 999rpx;
}
