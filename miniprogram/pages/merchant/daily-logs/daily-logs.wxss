.daily-logs-page { padding-bottom: 40rpx; }
.loading-state { padding: 80rpx 0; text-align: center; }
.timeline { padding-top: 8rpx; }
.timeline-group { margin-bottom: 24rpx; }
.timeline-date { padding: 0 8rpx 16rpx; }
.timeline-date-text { font-size: 28rpx; font-weight: 700; color: #333333; }
.timeline-list { display: flex; flex-direction: column; gap: 20rpx; }
.timeline-item { display: flex; gap: 16rpx; }
.timeline-axis { width: 24rpx; display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
.timeline-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #E98657; margin-top: 28rpx; flex-shrink: 0; }
.timeline-line { width: 2rpx; flex: 1; background: #F2DEC9; margin-top: 8rpx; min-height: 40rpx; }
.timeline-item:last-child .timeline-line { display: none; }
.timeline-card { flex: 1; padding: 24rpx; margin-bottom: 0; }
.timeline-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12rpx; margin-bottom: 12rpx; }
.timeline-pet-name { display: block; font-size: 30rpx; font-weight: 600; color: #333333; }
.timeline-time { display: block; font-size: 22rpx; color: #999999; margin-top: 4rpx; }
.timeline-desc { font-size: 26rpx; color: #666666; line-height: 1.5; margin: 12rpx 0; }
.daily-checks { display: flex; flex-wrap: wrap; gap: 8rpx; }
.media-thumbs { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.media-thumb-wrap { display: inline-block; line-height: 0; }
.media-thumb { width: 200rpx; height: 200rpx; border-radius: 16rpx; background: #FFF1E7; }
.video-thumb { display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #E98657, #F7AA78); }
.video-play-icon { color: #fff; font-size: 36rpx; margin-left: 6rpx; }
.tag-orange { background: #FFF1E7; color: #E98657; font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; flex-shrink: 0; }
.video-modal { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0,0,0,0.75); z-index: 1000; display: flex; align-items: center; justify-content: center; }
.video-modal-body { width: 90%; }
.modal-video { width: 100%; height: 420rpx; border-radius: 16rpx; background: #000; }
.video-modal-close { margin-top: 24rpx; text-align: center; color: #fff; font-size: 28rpx; }
