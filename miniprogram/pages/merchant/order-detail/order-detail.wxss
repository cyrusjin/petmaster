.copy-hint {
  display: block;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: #999999;
}

.detail-row { display: flex; justify-content: space-between; align-items: center; padding: 14rpx 0; font-size: 26rpx; color: #333333; border-bottom: 1rpx solid #F2F4FF; }
.detail-row:last-child { border-bottom: none; }
.detail-row-stack { align-items: flex-start; gap: 16rpx; }
.detail-value { flex: 1; text-align: right; line-height: 1.6; word-break: break-all; }
.pet-profile-head { display: flex; justify-content: center; margin-bottom: 20rpx; }
.pet-profile-photo { width: 220rpx; height: 220rpx; border-radius: 16rpx; }
.pet-profile-placeholder {
  width: 220rpx;
  height: 220rpx;
  border-radius: 16rpx;
  background: #F7F8FA;
  border: 1rpx solid #E8ECF0;
  color: #999999;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.order-export-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 750px;
  height: 2000px;
  opacity: 0;
  pointer-events: none;
}

.price-pending-desc {
  display: block;
  font-size: 26rpx;
  color: #E65100;
  line-height: 1.6;
}

.detail-action-btn {
  width: 100%;
  margin-left: 0 !important;
  margin-right: 0 !important;
  height: 80rpx !important;
  line-height: 80rpx !important;
  font-size: 28rpx !important;
  border-radius: 40rpx !important;
  padding: 0 !important;
  font-weight: 500;
}

.detail-action-btn::after { border: none; }

.detail-action-primary {
  background: #1D3D7A !important;
  color: #FFFFFF !important;
}

.detail-action-blue {
  background: #2B5AA0 !important;
  color: #FFFFFF !important;
}

.detail-action-outline {
  background: #FFFFFF !important;
  color: #1D3D7A !important;
  border: 2rpx solid #1D3D7A !important;
}

.detail-action-warning {
  background: #F57C00 !important;
  color: #FFFFFF !important;
}

.detail-action-danger {
  background: #E53935 !important;
  color: #FFFFFF !important;
}