.admin-tools-card {
  margin-bottom: 24rpx;
}
.admin-tools-head {
  margin-bottom: 12rpx;
}
.admin-tools-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #E98657;
}
.admin-tools-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
  margin-bottom: 20rpx;
}
.clear-cache-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #E53935;
  border: 2rpx solid #E53935;
  background: #fff;
}
.clear-cache-btn::after {
  border: none;
}

.empty-card {
  text-align: center;
  padding: 48rpx 32rpx;
}
.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}
.empty-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
}
.apply-card {
  margin-bottom: 24rpx;
}
.apply-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.apply-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #E98657;
}
.apply-status {
  font-size: 22rpx;
  color: #F57C00;
  background: #FFF3E0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}
.detail-value {
  flex: 1;
  text-align: right;
  word-break: break-all;
}
.apply-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.reject-btn,
.approve-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}
.reject-btn {
  color: #E53935;
  border: 2rpx solid #E53935;
  background: #fff;
}
.reject-btn::after {
  border: none;
}
