.page-root { min-height: 100%; }
.upload-row { display: flex; }
.upload-preview { width: 160rpx; height: 160rpx; border-radius: 16rpx; border: 3rpx solid #E8ECF0; }
.upload-btn { width: 160rpx; height: 160rpx; border-radius: 16rpx; background: #F7F8FA; border: 2rpx dashed #D0D8E8; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #2B5AA0; font-size: 48rpx; }
.pet-type-group { display: flex; flex-wrap: wrap; gap: 16rpx; }
.pet-type-item {
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  color: #333333;
  background: #fff;
  border: 2rpx solid #E8ECF0;
  border-radius: 16rpx;
}
.pet-type-item.active {
  color: #1D3D7A;
  background: #F2F4FF;
  border-color: #1D3D7A;
  font-weight: 600;
}
.date-picker-trigger {
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  color: #333333;
}
.date-picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}
.date-picker-panel {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  overflow: hidden;
}
.date-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid #E8ECF0;
}
.date-picker-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}
.date-picker-action {
  font-size: 28rpx;
  color: #999999;
  padding: 8rpx 12rpx;
}
.date-picker-confirm {
  color: #1D3D7A;
  font-weight: 600;
}
.date-picker-wheel {
  width: 100%;
  height: 420rpx;
}
.date-picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #333333;
}