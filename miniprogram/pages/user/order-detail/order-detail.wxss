.copy-hint {
  display: block;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: #999999;
}

.detail-row { display: flex; justify-content: space-between; align-items: center; padding: 14rpx 0; font-size: 26rpx; color: #333333; border-bottom: 1rpx solid #F2F4FF; }
.detail-row:last-child { border-bottom: none; }

.order-action-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}
.order-action-btn {
  flex: 1;
  margin: 0 !important;
  height: 80rpx !important;
  line-height: 80rpx !important;
  font-size: 28rpx !important;
  border-radius: 40rpx !important;
  padding: 0 !important;
}
.order-action-btn::after { border: none; }
.order-action-cancel {
  background: #FFFFFF !important;
  color: #E53935 !important;
  border: 2rpx solid #E53935 !important;
}
.order-action-edit {
  background: #1D3D7A !important;
  color: #FFFFFF !important;
  border: none !important;
}
