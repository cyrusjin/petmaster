.auth-inline {
  margin-bottom: 20rpx;
}

.auth-inline-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #000;
  margin-bottom: 12rpx;
}

.auth-inline-tip {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.auth-phone-group {
  margin-bottom: 8rpx;
}

.auth-phone-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #F7F8FA;
  border: 2rpx solid #E8ECF0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1D3D7A;
  font-weight: 500;
  padding: 0;
}

.auth-phone-btn::after {
  border: none;
}

.auth-save-btn {
  margin-top: 16rpx;
}

.auth-nickname-input {
  height: 80rpx;
}
