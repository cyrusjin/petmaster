.merchant-tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #fff;
  border-top: 1rpx solid #E8ECF0;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
  z-index: 999;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0 16rpx;
  color: #999999;
}
.tab-item.active { color: #1D3D7A; }
.tab-icon-img {
  width: 44rpx;
  height: 44rpx;
  display: block;
}
.tab-text { font-size: 22rpx; margin-top: 4rpx; font-weight: 500; }
