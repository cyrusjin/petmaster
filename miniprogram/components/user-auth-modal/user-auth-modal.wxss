.auth-modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1300;
}

.auth-modal-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.auth-modal-panel {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.auth-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
}

.auth-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.auth-modal-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 40rpx;
  color: #999999;
}

.auth-modal-body {
  padding: 0 32rpx 8rpx;
}

.auth-modal-tip {
  display: block;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #666666;
}

.auth-nickname-input {
  height: 88rpx;
}

.auth-phone-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0;
  padding: 0 24rpx;
  background: #F2F4FF;
  color: #1D3D7A;
  font-size: 28rpx;
  font-weight: 600;
  border: 2rpx solid #C5CEE0;
  border-radius: 16rpx;
  text-align: center;
  box-sizing: border-box;
}
.auth-phone-btn::after {
  border: none;
}

.auth-modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx 32rpx;
}

.auth-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  margin: 0;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
}
.auth-btn::after {
  border: none;
}

.auth-btn-ghost {
  background: #F7F8FA;
  color: #666666;
}

.auth-btn-primary {
  background: #1D3D7A;
  color: #FFFFFF;
  font-weight: 600;
}
