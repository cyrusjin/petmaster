.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1rpx solid #E8ECF0;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.04);
  z-index: 10000;
  box-sizing: border-box;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999999;
}

.tab-bar-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.tab-bar-text {
  font-size: 22rpx;
  margin-top: 6rpx;
  font-weight: 500;
  color: #999999;
}

.tab-bar-text.active {
  color: #1D3D7A;
}
