PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/petmaster
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# 宠主端小程序（兼容旧变量名）
WX_APPID=wx95d01c319ed4f686
WX_SECRET=your-user-app-secret
# 可选显式写法：
# WX_USER_APPID=wx95d01c319ed4f686
# WX_USER_SECRET=your-user-app-secret

# 商家端小程序（独立 AppID；未配置时回退到宠主端凭证，仅供本地联调）
WX_MERCHANT_APPID=wx327ccf77cdedc252
WX_MERCHANT_SECRET=your-merchant-app-secret

# 媒体文件：存轻量服务器本地磁盘
MEDIA_ROOT=/opt/petmaster/media
API_PUBLIC_BASE_URL=https://api.petmaster.me
MEDIA_PUBLIC_BASE_URL=https://api.petmaster.me/media

# 开发时可设为 true，跳过微信 code2session，用 mock openid
DEV_MOCK_WECHAT=false

# 官网管理后台账号（格式：用户名:密码,用户名:密码）
ADMIN_ACCOUNTS=jinsen:PetMaster@2026,reviewer:Review@2026
ADMIN_JWT_EXPIRES_IN=8h
