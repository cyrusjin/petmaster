PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/petmaster
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# 微信小程序
WX_APPID=wxeeeb958364d3c6d9
WX_SECRET=your-app-secret

# 阿里云 OSS
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your-ram-access-key-id
OSS_ACCESS_KEY_SECRET=your-ram-access-key-secret
# 可选：自定义域名，如 https://cdn.example.com
OSS_PUBLIC_BASE_URL=
# true=公共读直接拼 URL；false=返回签名 URL
OSS_PUBLIC_READ=true
# 签名 URL 有效期（秒）
OSS_SIGNED_URL_EXPIRES=3600

# 开发时可设为 true，跳过微信 code2session，用 mock openid
DEV_MOCK_WECHAT=false
