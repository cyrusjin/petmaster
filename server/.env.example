PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/petmaster
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# 宠主端小程序（兼容旧变量名）
WX_APPID=wx95d01c319ed4f686
WX_SECRET=your-user-app-secret
# 可选显式写法：
# WX_USER_APPID=wx95d01c319ed4f686
# WX_USER_SECRET=your-user-app-secret

# 商家端小程序（独立 AppID；未配置时回退到宠主端凭证，仅供本地联调）
WX_MERCHANT_APPID=wx327ccf77cdedc252
WX_MERCHANT_SECRET=your-merchant-app-secret

# 服务号（模板消息；回调 URL: https://api.petmaster.me/api/wechat/oa）
WX_OA_APPID=your-oa-appid
WX_OA_SECRET=your-oa-secret
WX_OA_TOKEN=your-callback-token
# 明文模式可不填；安全模式需填 EncodingAESKey（43 位）
# WX_OA_AES_KEY=

# 小程序消息推送（mediaCheckAsync 审图结果；两端后台都配同一 URL）
# URL: https://api.petmaster.me/api/wechat/mp
# 未单独配置时回退使用 WX_OA_TOKEN
# WX_MP_TOKEN=your-mp-push-token
# 安全模式 EncodingAESKey（两端可填相同值）；明文模式可不填
# WX_MP_AES_KEY=
# 上传时是否同步 imgSecCheck 拦截（默认 true）
# WX_MEDIA_SYNC_CHECK=true
# 小程序内引导关注用的二维码图 URL（可放 /media 下）
# WX_OA_QRCODE_URL=https://api.petmaster.me/media/oa-qrcode.png
# 关注欢迎：被动回复文字 + 客服消息小程序卡片（默认商家端）
# WX_OA_WELCOME_TEXT=欢迎关注熠森宠物管家！我是你的宠物管家助手～点击下方小程序，即可预约托管、查看日常打卡，并及时接收服务通知。
# WX_OA_WELCOME_MP_APPID=wx327ccf77cdedc252
# WX_OA_WELCOME_MP_PATH=pages/index/index
# WX_OA_WELCOME_MP_TITLE=打开宠物管家
# 卡片封面：服务号素材库图片 media_id（永久素材更稳；不填则只发文字；有店铺头像时优用店铺头像）
# WX_OA_WELCOME_THUMB_MEDIA_ID=
WX_OA_TEMPLATE_NEW_ORDER=
WX_OA_TEMPLATE_ORDER_STATUS=
# 服务号模板：客户跟进提醒（门店名称/客户名称/项目名称/完成时间）
WX_OA_TEMPLATE_DAILY_CHECK=VXQhSsjQ2Tkg2hEgvTbVOzKCbm9yllMZGAk9VHIA8pY
# 可选：覆盖模板字段名映射（JSON），默认 thing1~thing3 + time4
# WX_OA_FIELDS_NEW_ORDER={"orderNo":"character_string1","petName":"thing2","serviceType":"thing3","reserveTime":"time4","storeName":"thing5"}
# WX_OA_FIELDS_ORDER_STATUS={"orderNo":"character_string1","petName":"thing2","status":"phrase3","storeName":"thing4","updateTime":"time5"}
# WX_OA_FIELDS_DAILY_CHECK={"storeName":"thing1","customerName":"thing2","projectName":"thing3","checkTime":"time4"}

# 入驻申请通知管理员（小程序昵称，按 users.nickName 匹配）
WX_OA_ADMIN_NOTIFY_NICKNAMES=Eason_,Freddie
# 小程序 openid（按 users 表查绑定的服务号 openid）
# WX_OA_ADMIN_NOTIFY_MP_OPENIDS=omhI83ZQvXkc3XGzIfPMlz12F33I
# 可选：按微信号匹配（users.wechatId）
# WX_OA_ADMIN_NOTIFY_WECHAT_IDS=
# 方式一：微信号直接映射服务号 openid（关注并绑定后填入）
# WX_OA_ADMIN_NOTIFY_MAP=NYS_Eason:oSslh3O_xxx,VanlaStory:oXxx
# 方式二：直接写服务号 openid 列表
# WX_OA_ADMIN_NOTIFY_OA_OPENIDS=
# 方式三：管理员在小程序资料中填写 wechatId 并绑定服务号后，按用户表 wechatId 匹配

# 腾讯位置服务 Key（WebServiceAPI，服务端代理驾车距离）
TENCENT_MAP_KEY=

# 媒体文件：存轻量服务器本地磁盘
MEDIA_ROOT=/opt/petmaster/media
API_PUBLIC_BASE_URL=https://api.petmaster.me
MEDIA_PUBLIC_BASE_URL=https://api.petmaster.me/media

# 开发时可设为 true，跳过微信 code2session，用 mock openid
DEV_MOCK_WECHAT=false

# 官网管理后台账号（格式：用户名:密码,用户名:密码）
ADMIN_ACCOUNTS=jinsen:PetMaster@2026,reviewer:Review@2026
ADMIN_JWT_EXPIRES_IN=8h
