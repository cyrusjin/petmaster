PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/petmaster
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# 宠主端小程序（兼容旧变量名）
WX_APPID=wx95d01c319ed4f686
WX_SECRET=your-user-app-secret
# 可选显式写法：
# WX_USER_APPID=wx95d01c319ed4f686
# WX_USER_SECRET=your-user-app-secret

# 商家端小程序（独立 AppID；未配置时回退到宠主端凭证，仅供本地联调）
WX_MERCHANT_APPID=wx327ccf77cdedc252
WX_MERCHANT_SECRET=your-merchant-app-secret

# 服务号（模板消息；回调 URL: https://api.petmaster.me/api/wechat/oa）
WX_OA_APPID=your-oa-appid
WX_OA_SECRET=your-oa-secret
WX_OA_TOKEN=your-callback-token
# 明文模式可不填；安全模式需填 EncodingAESKey（43 位）
# WX_OA_AES_KEY=
# 小程序内引导关注用的二维码图 URL（可放 /media 下）
# WX_OA_QRCODE_URL=https://api.petmaster.me/media/oa-qrcode.png
# 模板 ID（在服务号后台申请后填写）
WX_OA_TEMPLATE_NEW_ORDER=
WX_OA_TEMPLATE_ORDER_STATUS=
WX_OA_TEMPLATE_DAILY_CHECK=
# 可选：覆盖模板字段名映射（JSON），默认见 config.js
# WX_OA_FIELDS_NEW_ORDER={"orderNo":"character_string1","petName":"thing2","serviceType":"thing3","reserveTime":"time4","storeName":"thing5"}
# WX_OA_FIELDS_ORDER_STATUS={"orderNo":"character_string1","petName":"thing2","status":"phrase3","storeName":"thing4","updateTime":"time5"}
# WX_OA_FIELDS_DAILY_CHECK={"petName":"thing1","checks":"thing2","storeName":"thing3","checkTime":"time4"}

# 腾讯位置服务 Key（WebServiceAPI，服务端代理驾车距离）
TENCENT_MAP_KEY=

# 媒体文件：存轻量服务器本地磁盘
MEDIA_ROOT=/opt/petmaster/media
API_PUBLIC_BASE_URL=https://api.petmaster.me
MEDIA_PUBLIC_BASE_URL=https://api.petmaster.me/media

# 开发时可设为 true，跳过微信 code2session，用 mock openid
DEV_MOCK_WECHAT=false

# 官网管理后台账号（格式：用户名:密码,用户名:密码）
ADMIN_ACCOUNTS=jinsen:PetMaster@2026,reviewer:Review@2026
ADMIN_JWT_EXPIRES_IN=8h
